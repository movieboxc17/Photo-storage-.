<%- include('../partials/head', { title: 'Enter Access Code', siteTitle, stylesheet: 'public.css' }) %>
<main class="public-wrap center">
  <section class="card code-card <%= error ? 'shake' : '' %>">
    <h1><%= album.name %></h1>
    <p>This album is protected. Enter the 5-digit access code.</p>
    <% if (error) { %><div class="toast error"><%= error %></div><% } %>
    <form method="post" action="/share/<%= token %>/code" class="code-form">
      <input name="d1" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <input name="d2" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <input name="d3" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <input name="d4" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <input name="d5" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
      <button class="btn primary" type="submit">Unlock</button>
    </form>
  </section>
</main>
<script>
  const codeInputs = document.querySelectorAll('.code-form input');
  codeInputs.forEach((input, index) => {
    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '');
      if (input.value && codeInputs[index + 1]) codeInputs[index + 1].focus();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && codeInputs[index - 1]) codeInputs[index - 1].focus();
    });
  });
</script>
<%- include('../partials/foot') %>
