<%- include('../partials/head', { title: 'Dashboard', siteTitle, stylesheet: 'admin.css' }) %>
<div class="layout">
  <aside class="sidebar">
    <h2><%= siteTitle %></h2>
    <nav>
      <a class="active" href="/admin">Dashboard</a>
      <a href="/admin/albums">Albums</a>
      <a href="/admin/upload">Upload</a>
      <a href="/admin/settings">Settings</a>
    </nav>
    <form method="post" action="/admin/logout"><button class="btn secondary" type="submit">Logout</button></form>
  </aside>
  <main class="content">
    <% if (flash) { %><div class="toast <%= flash.type %>"><%= flash.message %></div><% } %>
    <h1>Dashboard</h1>
    <section class="cards">
      <article class="card"><h3>Total Albums</h3><p><%= stats.albums %></p></article>
      <article class="card"><h3>Total Photos</h3><p><%= stats.photos %></p></article>
      <article class="card"><h3>Storage Used</h3><p><%= stats.storage %></p></article>
    </section>

    <section class="card">
      <h2>Albums</h2>
      <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Photos</th><th>Views</th><th>Code</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (!albums.length) { %>
            <tr><td colspan="5">No albums yet.</td></tr>
          <% } %>
          <% albums.forEach((album) => { %>
            <tr>
              <td>
                <strong><%= album.name %></strong><br />
                <small><a target="_blank" href="/share/<%= album.token %>">/share/<%= album.token %></a></small>
              </td>
              <td><%= album.photo_count %></td>
              <td><%= album.view_count %></td>
              <td><%= album.access_code || 'Disabled' %></td>
              <td class="actions">
                <a class="btn small secondary" href="/admin/albums/<%= album.id %>/edit">Edit</a>
                <form method="post" action="/admin/albums/<%= album.id %>/delete" onsubmit="return confirm('Delete album and all photos?')">
                  <button class="btn small danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </section>
  </main>
</div>
<%- include('../partials/foot') %>
